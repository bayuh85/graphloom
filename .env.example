# Copy to .env and fill in a key from https://atmorouter.dev
# graphloom loads .env from the working directory without overriding
# variables that are already set in the environment.

ATMOROUTER_API_KEY=ar-your-key-here

# GRAPHLOOM_API_KEY wins over ATMOROUTER_API_KEY when both are set.
# GRAPHLOOM_API_KEY=

# OpenAI-compatible base URL. Any compatible gateway works.
# GRAPHLOOM_BASE_URL=https://atmorouter.dev/v1

# Cheap text model from the AtmoRouter catalog. Override freely.
# GRAPHLOOM_MODEL=zai/glm-5.3-flash

# openai (default) posts to {base}/chat/completions
# anthropic posts to {base}/messages
# GRAPHLOOM_API_STYLE=openai
